# Vercel server environment. Never commit real secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Vercel -> RunPod Serverless job submission
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
# Set true only after the worker and Supabase storage have been deployed and verified.
AHM_VIDEO_WORKER_READY=false

# RunPod worker environment (set these in the worker endpoint, not in browser code)
# The same Gemini key is used for the Director, video clips and narration.
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_FALLBACK_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Charon

# Original background music is optional and must be explicitly enabled.
LYRIA_ENABLED=false
LYRIA_MODEL=lyria-3.5

# Durable MP4 storage (private bucket + signed download links)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=ahm-videos
